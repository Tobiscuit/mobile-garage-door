{
  "name": "mobile-garage-door",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // vinext 1.0 ships its own fetch handler, which registers the cache adapters
  // declared in vite.config.ts and passes the ExecutionContext through to them.
  // It replaces the hand-written worker/index.ts that 0.0.x required.
  "main": "vinext/server/fetch-handler",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobile-garage-door-db",
      "database_id": "c3a12bb6-5693-43b6-b333-c8b693e9d91b",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "mobile-garage-door-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_CACHE",
      "id": "14e1c4a34c4f4246b4455b28d72b6231"
    },
    {
      "binding": "TRACKING_KV",
      "id": "f0fcc9d39cc9422ea2c932fa968dc6a9"
    }
  ],
  // Preview URLs are how a branch gets reviewed before it is promoted: the
  // Workers Builds preview trigger runs `wrangler versions upload`, which
  // publishes a version WITHOUT routing production traffic to it. Stated
  // explicitly rather than left to defaults — preview URLs otherwise follow
  // `workers_dev`, which was also unset, so the behaviour was inherited and
  // unreviewable. See docs/delivery-pipeline.md.
  //
  // A preview version binds to the PRODUCTION D1, R2 and KV resources declared
  // below; it is isolated in code, not in data. Access must gate these URLs.
  "preview_urls": true,

  // Custom domains: mobilgaragedoor.com → this Worker
  "routes": [
    { "pattern": "mobilgaragedoor.com/*", "zone_id": "6dcb9ee96a3af731e0124a38ecaf9114" },
    { "pattern": "www.mobilgaragedoor.com/*", "zone_id": "6dcb9ee96a3af731e0124a38ecaf9114" }
  ]
}